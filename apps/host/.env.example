# Host supervisor
PORT=8787
HOST=0.0.0.0

# OpenRouter (required for agent chat). Safe in .env.
OPENROUTER_API_KEY=

# Do NOT put DSH_PROVIDER / DSH_MODEL / DSH_HOME in this file.
# dsh refuses those in .env (launching-environment only).
# Host defaults: openrouter + deepseek/deepseek-v4-flash (override by exporting
# DSH_PROVIDER / DSH_MODEL in your shell if needed).

# Privy (required — verify access tokens)
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# App authorization private key for live Wallet API broadcasts (PKCS8 base64)
PRIVY_AUTHORIZATION_PRIVATE_KEY=
# Key quorum id for that auth key (used as session signer on user wallets)
PRIVY_AUTHORIZATION_KEY_QUORUM_ID=

# Optional fallback if a user has no wallet yet (smoke / tooling)
SQUADRONS_DEMO_WALLET=
BASE_RPC_URL=https://mainnet.base.org
ETHEREUM_RPC_URL=https://ethereum.publicnode.com
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
OPTIMISM_RPC_URL=https://mainnet.optimism.io
UNICHAIN_RPC_URL=https://mainnet.unichain.org
WORLDCHAIN_RPC_URL=https://worldchain-mainnet.g.alchemy.com/public
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ARC_RPC_URL=https://rpc.testnet.arc.io
# Host sets SQUADRONS_AGENT_CHAIN_ID and SQUADRONS_USER_WALLET per dsh turn.

# 0x Swap API (DEX quotes / swap builds on ETH L2 home chains)
ZEROEX_API_KEY=

# Circle Swap Kit (Arc Testnet USDC↔EURC — not 0x). Optional but recommended
# for production volume; permissionless estimates work without a key.
# Create at https://console.circle.com/ — use a TEST key for Arc Testnet.
CIRCLE_API_KEY=

# Arc Testnet RPC (optional override; defaults to https://rpc.testnet.arc.io)
# ARC_RPC_URL=https://rpc.testnet.arc.io

# The Graph — Chain Search (out of the box for all agents)
# Free Subgraph Studio Gateway key: https://thegraph.com/studio/ (100k queries/mo free)
# Shared across all tenants — set a spending limit on the key. Users never paste this.
THE_GRAPH_GATEWAY_API_KEY=

# Tenderly (required for live mode simulation before broadcast)
TENDERLY_ACCESS_KEY=
TENDERLY_ACCOUNT_SLUG=
TENDERLY_PROJECT_SLUG=

# Trade executor ceiling: off | dry_run | live
# Desk runMode (observe/paper/live) cannot exceed this.
# dry_run (default) = paper fills only; live = desk may enable real broadcast
SQUADRONS_EXECUTION_MODE=dry_run

# dsh preflight (host startup). Default: refuse to listen if Cordis plugins/peers look broken.
# SQUADRONS_DSH_SKIP_PREFLIGHT=1
# SQUADRONS_DSH_PREFLIGHT_STRICT=0

# Optional SearXNG base URL for search_x (after DuckDuckGo HTML + Bing RSS).
# Instance must enable format=json. Example: http://127.0.0.1:8080
# SQUADRONS_SEARXNG_URL=

# Local SQLite path (created at runtime later)
DATABASE_PATH=./data/squadrons.db
